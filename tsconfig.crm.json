{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "src/features/crm/**/*.ts",
    "src/features/crm/**/*.tsx",
    "src/components/admin/**/*.tsx",
    "src/lib/crm/**/*.ts",
    "src/types/**/*.d.ts",
    "src/app/api/admin/**/*.ts",
    "src/app/(admin)/**/*.tsx",
    "middleware.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/* 2.ts",
    "**/* 2.tsx"
  ]
}
